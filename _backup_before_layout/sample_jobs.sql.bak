-- =====================================================================
-- Sample jobs for the Job Matches page (/pages/jobs)
-- How to use:
--   1. Open Supabase Dashboard -> SQL Editor -> New query
--   2. Replace YOUR_LOGIN_EMAIL below with the email you log in with
--   3. Click "Run", then refresh /pages/jobs
-- All rows are tagged "sample": true so you can remove them later (see bottom).
-- =====================================================================

with me as (
  select id from auth.users where email = 'YOUR_LOGIN_EMAIL'
)
insert into public.user_documents (user_id, type, title, content, created_at)
select me.id, 'job', j.title, j.content, now() - j.age
from me,
(values
  ('AI Automation Engineer', interval '2 hours', jsonb_build_object(
    'title','AI Automation Engineer','company','TechFlow','location','Remote','work_type','Remote',
    'experience','Mid','match_score',94,'url','https://example.com/jobs/1',
    'cv_url','https://example.com/cv/1','cover_letter_url','https://example.com/cl/1',
    'source','automatic','sample',true)),
  ('AI Systems Engineer', interval '5 hours', jsonb_build_object(
    'title','AI Systems Engineer','company','InnovateAI','location','Germany','work_type','On-site',
    'experience','Senior','match_score',91,'url','https://example.com/jobs/2',
    'cv_url','https://example.com/cv/2','cover_letter_url','https://example.com/cl/2',
    'source','automatic','sample',true)),
  ('Machine Learning Engineer', interval '20 hours', jsonb_build_object(
    'title','Machine Learning Engineer','company','DataWorks','location','Remote','work_type','Remote',
    'experience','Mid','match_score',87,'url','https://example.com/jobs/3',
    'cv_url','https://example.com/cv/3','cover_letter_url','https://example.com/cl/3',
    'source','automatic','sample',true)),
  ('Data Engineer', interval '3 hours', jsonb_build_object(
    'title','Data Engineer','company','CloudNine GmbH','location','Berlin','work_type','Hybrid',
    'experience','Junior','match_score',78,'url','https://example.com/jobs/4',
    'cv_url','https://example.com/cv/4',
    'source','automatic','sample',true)),
  ('Python Developer', interval '8 hours', jsonb_build_object(
    'title','Python Developer','company','Softwerk','location','Munich','work_type','On-site',
    'experience','Mid','match_score',72,'url','https://example.com/jobs/5',
    'source','automatic','sample',true)),
  ('NLP Engineer', interval '3 days', jsonb_build_object(
    'title','NLP Engineer','company','LinguaTech','location','Remote','work_type','Remote',
    'experience','Senior','match_score',89,'url','https://example.com/jobs/6',
    'cv_url','https://example.com/cv/6','cover_letter_url','https://example.com/cl/6',
    'source','automatic','sample',true)),
  ('Automation Consultant', interval '12 days', jsonb_build_object(
    'title','Automation Consultant','company','ProcessPro','location','Hamburg','work_type','Hybrid',
    'experience','Senior','match_score',65,
    'source','automatic','sample',true)),
  ('Frontend Developer (React)', interval '1 hour', jsonb_build_object(
    'title','Frontend Developer (React)','company','WebWorks','location','Remote','work_type','Remote',
    'experience','Junior','match_score',82,'url','https://example.com/jobs/8',
    'source','manual','sample',true))
) as j(title, age, content);


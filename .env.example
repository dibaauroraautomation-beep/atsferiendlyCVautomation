# Google Drive Integration
# Create a Google Cloud project, enable Drive API, create OAuth 2.0 Client ID
# and an API key. Add http://localhost:3000/api/drive/callback (use your port)
# to the authorized redirect URIs in the OAuth client settings.
NEXT_PUBLIC_GOOGLE_API_KEY=
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=

# N8N Webhook URLs
# Configure these to point to your N8N instance
N8N_WEBHOOK_URL=
N8N_INTERVIEW_WEBHOOK_URL=

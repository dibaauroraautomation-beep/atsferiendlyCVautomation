export default function AutomaticDashboardPage() {
  const supabase = createClient();
  const { user, profile, loading: authLoading, signOut } = useAuth();

  const [jobs, setJobs] = useState<JobRow[]>([]);
  const [stats, setStats] = useState<Stats>({
    jobsToday: 0,
    matchingJobs: 0,
    cvsGenerated: 0,
    applicationsThisWeek: 0,
  });
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");
  const [menuOpen, setMenuOpen] = useState(false);

  /* ---------- Name shown in header ---------- */
  const fullName = useMemo(() => {
    const fromProfile = [profile?.first_name, profile?.last_name].filter(Boolean).join(" ").trim();
    if (fromProfile) return fromProfile;
    const meta = user?.user_metadata ?? {};
    const fromMeta = [meta.first_name, meta.last_name].filter(Boolean).join(" ").trim();
    return fromMeta || user?.email?.split("@")[0] || "User";
  }, [profile, user]);

  const firstName = profile?.first_name || fullName.split(" ")[0];
  const avatarUrl: string | undefined = user?.user_metadata?.avatar_url;

  /* ---------- Load data (RLS returns only this user's rows) ---------- */
  useEffect(() => {
    if (!user) return;

    const load = async () => {
      setLoading(true);
      setError("");

      const today = startOfDay(new Date());
      const weekAgo = new Date(today);
      weekAgo.setDate(weekAgo.getDate() - 6);

      const [jobsRes, cvRes, appRes] = await Promise.all([
        supabase
          .from("user_documents")
          .select("id, created_at, content")
          .eq("type", "job")
          .order("created_at", { ascending: false }),
        supabase
          .from("user_documents")
          .select("id", { count: "exact", head: true })
          .eq("type", "resume"),
        supabase
          .from("user_documents")
          .select("id", { count: "exact", head: true })
          .eq("type", "application")
          .gte("created_at", weekAgo.toISOString()),
      ]);

      if (jobsRes.error || cvRes.error || appRes.error) {
        setError("Could not load your dashboard data. Refresh the page to try again.");
        console.error(jobsRes.error || cvRes.error || appRes.error);
      }

      const jobRows = (jobsRes.data ?? []) as JobRow[];
      setJobs(jobRows);
      setStats({
        jobsToday: jobRows.filter((j) => new Date(j.created_at) >= today).length,
        matchingJobs: jobRows.filter((j) => score(j) >= MATCH_THRESHOLD).length,
        cvsGenerated: cvRes.count ?? 0,
        applicationsThisWeek: appRes.count ?? 0,
      });
      setLoading(false);
    };

    load();
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [user]);

  /* ---------- Chart: jobs found per day, last 7 days ---------- */
  const chart = useMemo(() => {
    const today = startOfDay(new Date());
    const days = Array.from({ length: 7 }, (_, i) => {
      const d = new Date(today);
      d.setDate(d.getDate() - (6 - i));
      return d;
    });
    const values = days.map((d) => {
      const next = new Date(d);
      next.setDate(next.getDate() + 1);
      return jobs.filter((j) => {
        const t = new Date(j.created_at);
        return t >= d && t < next;
      }).length;
    });
    const labels = days.map((d) => d.toLocaleDateString(undefined, { weekday: "short" }));
    return { labels, values };
  }, [jobs]);

  const topJobs = useMemo(
    () => [...jobs].sort((a, b) => score(b) - score(a)).slice(0, 5),
    [jobs]
  );

  const lastSearch = jobs[0]?.created_at;
  const automationActive = Boolean(profile?.cv_path) || jobs.length > 0;

  /* ---------- Sidebar ---------- */
  const navItems = [
    { label: "Dashboard", href: "/pages/automatic-Dashboard", icon: ICONS.home, active: true },
    { label: "Jobs", href: "#top-jobs", icon: ICONS.jobs },
    { label: "Applications & Reports", href: "/pages/ApplicationsStatus", icon: ICONS.report },
    { label: "Profile", href: "/pages/setting", icon: ICONS.user },
  ];

  const Sidebar = (
    <aside className="flex flex-col h-full w-64 bg-slate-900 text-slate-300">
      <div className="flex items-center gap-2 px-5 h-16 border-b border-slate-800">
        <div className="w-8 h-8 rounded-full border-[3px] border-violet-500 border-r-transparent" />
        <span className="text-xl font-bold text-white">
          Career<span className="text-violet-400">AI</span>
        </span>
      </div>

      <nav className="flex-1 px-3 py-4 space-y-1">
        {navItems.map((item) => (
          <Link
            key={item.label}
            href={item.href}
            onClick={() => setMenuOpen(false)}
            className={`flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm transition ${
              item.active ? "bg-slate-800 text-white font-medium" : "hover:bg-slate-800/60 hover:text-white"
            }`}
          >
            <Icon d={item.icon} />
            <span className="flex-1">{item.label}</span>
            {item.active && <span className="w-2 h-2 rounded-full bg-violet-500" />}
          </Link>
        ))}
      </nav>

      <div className="px-3 py-4 border-t border-slate-800">
        <button
          onClick={signOut}
          className="w-full flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm hover:bg-slate-800/60 hover:text-white transition"
        >
          <Icon d={ICONS.logout} />
          Log out
        </button>
      </div>
    </aside>
  );

  /* ---------- Render ---------- */
  if (authLoading) {
    return (
      <div className="py-20 flex items-center justify-center text-sm text-slate-500">

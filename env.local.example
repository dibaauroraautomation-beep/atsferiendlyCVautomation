# Supabase Dashboard -> Project Settings -> API (or "Connect" button)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Use the anon / publishable key here. NEVER put the service_role / secret key in the frontend.
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_OR_PUBLISHABLE_KEY

# Reports page: "supabase" or "n8n" (the other one is the automatic fallback)
REPORTS_SOURCE=supabase
N8N_REPORTS_WEBHOOK_URL=https://YOUR-N8N/webhook/YOUR-PATH
N8N_REPORTS_SECRET=same-secret-as-in-the-n8n-Build-Report-node
REPORTS_FILTER_BY_EMAIL=true
REPORTS_TZ_OFFSET_HOURS=6

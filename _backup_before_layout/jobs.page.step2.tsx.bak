    //         <StatCard label="Matching Jobs" value={loading ? "–" : stats.matchingJobs} icon={ICONS.target} />
    //         <StatCard label="CVs Generated" value={loading ? "–" : stats.cvsGenerated} icon={ICONS.doc} />
